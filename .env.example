# PostgreSQL
POSTGRES_DB=taskmaster_db
POSTGRES_USER=taskmaster_user
POSTGRES_PASSWORD=taskmaster_password
POSTGRES_PORT=5433

# Application database connection
DB_URL=jdbc:postgresql://localhost:5433/taskmaster_db
DB_USERNAME=taskmaster_user
DB_PASSWORD=taskmaster_password
DB_POOL_SIZE=10

# Telegram
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN=your_bot_token

# Application
SERVER_PORT=8080
APP_LOG_LEVEL=INFO
REMINDERS_ENABLED=true
REMINDERS_POLL_INTERVAL=60000
REMINDERS_BATCH_SIZE=50
REMINDERS_MAX_ATTEMPTS=3
